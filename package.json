    "check:corridor": "tsx scripts/check-corridor.ts",
    "car": "node scripts/optimize-car.mjs",
    "city": "node scripts/optimize-city.mjs && node scripts/build-route.mjs && node scripts/trim-city.mjs && tsx scripts/clear-corridor.ts && tsx scripts/check-route.ts",
    "pacing": "tsx scripts/pacing-report.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
