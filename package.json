  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-route.ts && tsx scripts/check-contact.ts && tsx scripts/check-corridor.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:route": "tsx scripts/check-route.ts",
